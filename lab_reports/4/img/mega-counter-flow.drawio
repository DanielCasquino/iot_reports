<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="mega-counter-flow" name="MEGA counter flow">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="450" pageHeight="600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Start" vertex="1" parent="1" style="ellipse;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=18;spacing=8;">
          <mxGeometry as="geometry" x="100" y="0" width="230" height="45" />
        </mxCell>
        <mxCell id="setup" value="num = 20; serial ports: 115200&lt;br&gt;Wait 1000 ms; configure radio&lt;br&gt;Wait 500 ms after each AT call" vertex="1" parent="1" style="rounded=0;fillColor=#6d8764;strokeColor=#3A5431;fontColor=#ffffff;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=18;spacing=8;">
          <mxGeometry as="geometry" x="30" y="75" width="370" height="90" />
        </mxCell>
        <mxCell id="counter" value="Increment num by one;&lt;br&gt;encode decimal text as hex ASCII" vertex="1" parent="1" style="rounded=0;fillColor=#6d8764;strokeColor=#3A5431;fontColor=#ffffff;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=18;spacing=8;">
          <mxGeometry as="geometry" x="30" y="200" width="370" height="70" />
        </mxCell>
        <mxCell id="send" value="sendRAK: print command;&lt;br&gt;send AT+PSEND through Serial1" vertex="1" parent="1" style="rounded=0;fillColor=#6d8764;strokeColor=#3A5431;fontColor=#ffffff;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=18;spacing=8;">
          <mxGeometry as="geometry" x="30" y="305" width="370" height="70" />
        </mxCell>
        <mxCell id="response" value="Wait for available UART bytes;&lt;br&gt;read and print collected response" vertex="1" parent="1" style="rounded=0;fillColor=#6d8764;strokeColor=#3A5431;fontColor=#ffffff;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=18;spacing=8;">
          <mxGeometry as="geometry" x="30" y="410" width="370" height="70" />
        </mxCell>
        <mxCell id="delay" value="Wait 5000 ms" vertex="1" parent="1" style="rounded=0;fillColor=#6d8764;strokeColor=#3A5431;fontColor=#ffffff;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=18;spacing=8;">
          <mxGeometry as="geometry" x="60" y="515" width="310" height="55" />
        </mxCell>
        <mxCell id="a" edge="1" parent="1" source="start" target="setup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b" edge="1" parent="1" source="setup" target="counter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c" edge="1" parent="1" source="counter" target="send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="d" edge="1" parent="1" source="send" target="response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e" edge="1" parent="1" source="response" target="delay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="loop" edge="1" parent="1" source="delay" target="counter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="435" y="543" />
              <mxPoint x="435" y="235" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>