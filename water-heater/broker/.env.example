# MQTT
# MQTT_URL=mqtt://<broker-IP>:1883
MQTT_TEMPERATURE_QOS1=false

# Camera address and cadence, in milliseconds. Set the water poll to 0 for manual capture.
CAMERA_URL=http://<camera-IP>
CAMERA_POLL_MS=5000
CAMERA_MIRROR_POLL_MS=250

# Seven-segment OCR. Use coordinates from the camera's original JPEG.
CAMERA_READER=ssocr
# SSOCR_PATH=/usr/bin/ssocr
# CAMERA_CROP=140,0,180,240
# CAMERA_OCR_GUARD_CROP=90,0,230,240
# CAMERA_ROTATION=90
# CAMERA_SSOCR_SHEAR=0.06

# Measure these in the installed camera position. Light is independent of OCR.
# CAMERA_DISPLAY_REGION=140,0,180,240
# CAMERA_DISPLAY_DARK_MAX=<highest measured dark level>
# CAMERA_DISPLAY_LIT_MIN=<lowest measured readable dim level>

# Pilot LED calibration. npm run calibrate:color red (or green/unlit)
# COLOR_RED_REFERENCE=R,G,B,C
# COLOR_GREEN_REFERENCE=R,G,B,C
# COLOR_UNLIT_REFERENCE=R,G,B,C
# COLOR_MAX_DISTANCE=<measured normalized-vector tolerance>
# COLOR_DARK_MAX_CLEAR=<measured unlit clear-channel ceiling>

# Options used by the Tesseract fallback when CAMERA_READER=tesseract.
# CAMERA_MIN_CONFIDENCE=80
# CAMERA_INVERT=true
# CAMERA_THRESHOLD=128
# OCR_LANG_PATH=./ocr-data

# Separate DS18B20 bench mode. Pair with TEMPORARY_SENSOR_TEST_MODE=1 in the ESP32.
TEMPORARY_SENSOR_TEST_MODE=false
