# Local demo: keep the existing MQTT_URL or set the laptop broker here.
# MQTT_URL=mqtt://<broker-IP>:1883
# Address printed by the ESP32-CAM serial monitor. No camera reflash needed.
CAMERA_URL=http://<camera-IP>
# 0 = manual. Backend interval in ms, after the previous OCR finishes.
CAMERA_POLL_MS=5000
# Crop the digits ONLY. Pixel coordinates in the current original JPEG.
# CAMERA_CROP=200,150,140,80
CAMERA_MIN_CONFIDENCE=80
# CAMERA_INVERT=true
# CAMERA_THRESHOLD=128
# CAMERA_DISPLAY_REGION=130,0,140,240
# CAMERA_DISPLAY_DARK_MAX=<measured upper limit for the dark display>
# CAMERA_DISPLAY_LIT_MIN=<measured lower limit including the dim display>
# Optional local folder containing eng.traineddata.gz for offline OCR startup.
# OCR_LANG_PATH=./ocr-data

# Pilot calibration: measure with the sensor mounted, do not guess.
# `npm run calibrate:color red` (or green/unlit) prints the value to paste here.
# The red reference alone is enough to infer power=on; green also distinguishes
# heating from heat-preservation. Restart the backend after editing this file.
# COLOR_RED_REFERENCE=R,G,B,C
# COLOR_GREEN_REFERENCE=R,G,B,C
# COLOR_UNLIT_REFERENCE=R,G,B,C
# COLOR_MAX_DISTANCE=<measured normalized-vector tolerance>
# COLOR_DARK_MAX_CLEAR=<measured unlit clear-channel ceiling>

# Opt-in for two bright seven-segment digits. Crop is optional when framing excludes other lights.
# CAMERA_SEVEN_SEGMENT=true

# TEMPORARY: physical DS18B20 temperature; RGB/OCR diagnostics do not control power.
# Set false together with ESP32 TEMPORARY_SENSOR_TEST_MODE=0 to restore.
TEMPORARY_SENSOR_TEST_MODE=false

# Rotation applied after the optional crop in original image coordinates.
# CAMERA_ROTATION=90
